{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resolveflow:agent-proposal:v1",
  "title": "AgentProposalV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "proposal_id", "run_id", "case_id", "input_revision", "case_type", "recommended_action", "evidence_refs", "policy_refs", "reason_codes", "summary", "missing_evidence"],
  "properties": {
    "proposal_id": {"type": "string", "format": "uuid"},
    "run_id": {"type": "string", "format": "uuid"},
    "case_id": {"type": "string", "format": "uuid"},
    "input_revision": {"type": "integer", "minimum": 1},
    "case_type": {"enum": ["LOGISTICS", "DAMAGED", "WRONG_MISSING", "OUT_OF_SCOPE"]},
    "recommended_action": {"enum": ["REFUND", "RESHIP", "REQUEST_INFO", "MANUAL_REVIEW", "REJECT"]},
    "suggested_amount_minor": {"type": "integer", "minimum": 0, "maximum": 1000000000},
    "evidence_refs": {
      "type": "array", "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["observation_id", "source_ref", "source_version", "content_hash"],
        "properties": {
          "observation_id": {"type": "string", "minLength": 1},
          "source_ref": {"type": "string", "minLength": 1},
          "source_version": {"type": "string", "minLength": 1},
          "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "policy_refs": {
      "type": "array", "maxItems": 10,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["bundle_id", "version", "rule_id", "chunk_id", "content_hash"],
        "properties": {
          "bundle_id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "rule_id": {"type": "string", "minLength": 1},
          "chunk_id": {"type": "string", "minLength": 1},
          "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "reason_codes": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"}, "minItems": 1, "maxItems": 16, "uniqueItems": true},
    "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
    "missing_evidence": {"type": "array", "maxItems": 10, "items": {"type": "string", "maxLength": 200}},
    "schema_version": {"const": 1}
  },
  "allOf": [
    {"if": {"properties": {"recommended_action": {"enum": ["REFUND", "RESHIP"]}}}, "then": {"properties": {"evidence_refs": {"minItems": 1}, "policy_refs": {"minItems": 1}, "missing_evidence": {"maxItems": 0}}}}
  ]
}
