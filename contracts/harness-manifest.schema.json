{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resolveflow:harness-manifest:v1",
  "title": "Immutable Harness configuration (no credentials)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "harness_version", "code_revision", "graph_version", "state_schema_version", "prompt_hash", "context_policy_version", "tool_schema_hash", "verifier_version", "model", "budgets", "policy_manifest_hash", "index_generation"],
  "properties": {
    "schema_version": {"const": 1},
    "manifest_id": {"$ref": "#/$defs/hash"},
    "harness_version": {"$ref": "#/$defs/version"},
    "code_revision": {"$ref": "#/$defs/version"},
    "graph_version": {"$ref": "#/$defs/version"},
    "state_schema_version": {"type": "integer", "minimum": 1},
    "prompt_hash": {"$ref": "#/$defs/hash"},
    "context_policy_version": {"$ref": "#/$defs/version"},
    "tool_schema_hash": {"$ref": "#/$defs/hash"},
    "verifier_version": {"$ref": "#/$defs/version"},
    "policy_manifest_hash": {"$ref": "#/$defs/hash"},
    "index_generation": {"type": "string", "format": "uuid"},
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "model_id", "context_window_tokens", "token_counter_version", "parameters"],
      "properties": {
        "provider": {"$ref": "#/$defs/version"},
        "model_id": {"$ref": "#/$defs/version"},
        "context_window_tokens": {"type": "integer", "minimum": 1024, "maximum": 2147483647},
        "token_counter_version": {"$ref": "#/$defs/version"},
        "parameters": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "temperature": {"type": "number", "minimum": 0, "maximum": 2},
            "top_p": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
            "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647},
            "reasoning_effort": {"$ref": "#/$defs/version"}
          }
        }
      }
    },
    "budgets": {
      "type": "object", "additionalProperties": false,
      "required": ["max_model_calls", "max_external_calls", "max_local_reads", "max_total_input_tokens", "max_total_output_tokens", "max_prompt_tokens", "max_output_tokens", "active_deadline_seconds", "model_timeout_seconds"],
      "properties": {
        "max_model_calls": {"type": "integer", "minimum": 1, "maximum": 12, "default": 12},
        "max_external_calls": {"type": "integer", "minimum": 1, "maximum": 16, "default": 16},
        "max_local_reads": {"type": "integer", "minimum": 0, "maximum": 8, "default": 8},
        "max_total_input_tokens": {"type": "integer", "minimum": 1, "maximum": 40000, "default": 40000},
        "max_total_output_tokens": {"type": "integer", "minimum": 1, "maximum": 4000, "default": 4000},
        "max_prompt_tokens": {"type": "integer", "minimum": 1, "maximum": 8192, "default": 8192},
        "max_output_tokens": {"type": "integer", "minimum": 1, "maximum": 1024, "default": 1024},
        "active_deadline_seconds": {"type": "integer", "minimum": 1, "maximum": 120, "default": 120},
        "model_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 30, "default": 30}
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "version": {"type": "string", "minLength": 1, "maxLength": 200}
  }
}
