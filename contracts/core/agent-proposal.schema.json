{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resolveflow:core:agent-proposal:v2",
  "title": "AgentProposalV2",
  "description": "Core-v1.2 proposal a run submits to case-service as the payload of a PROPOSAL callback (docs/core-contracts.md:59). It must stay field-for-field identical to the ProposalPayload component of contracts/core/openapi-case.yaml; a test fails when the two drift apart. schema_version=2 and case_id are both carried, because docs/core-contracts.md:9 keeps the compat proposal's field structure (that document has schema_version 1) and docs/core-contracts.md:57 requires the body's subject to agree with the service JWT and the Case binding, which Java can only cross-check if the binding is present.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "run_id",
    "case_id",
    "input_revision",
    "case_type",
    "recommended_action",
    "summary",
    "reason_codes"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "proposal_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "input_revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "case_type": {"type": "string", "enum": ["LOGISTICS", "DAMAGED", "WRONG_MISSING", "OUT_OF_SCOPE"]},
    "recommended_action": {"type": "string", "enum": ["REFUND", "REQUEST_INFO", "MANUAL_REVIEW", "REJECT"]},
    "suggested_amount_minor": {"type": "integer", "minimum": 0, "maximum": 1000000000},
    "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"}
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["observation_id", "source_ref", "source_version", "content_hash"],
        "properties": {
          "observation_id": {"type": "string", "minLength": 1, "maxLength": 64},
          "source_ref": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^(?!https?://)[a-z][a-z0-9_]*:\\S+$"},
          "source_version": {"type": "string", "minLength": 1, "maxLength": 64},
          "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "policy_refs": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bundle_id", "version", "rule_id", "chunk_id", "content_hash"],
        "properties": {
          "bundle_id": {"type": "string", "minLength": 1, "maxLength": 64},
          "version": {"type": "string", "minLength": 1, "maxLength": 64},
          "rule_id": {"type": "string", "minLength": 1, "maxLength": 64},
          "chunk_id": {"type": "string", "minLength": 1, "maxLength": 64},
          "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "missing_evidence": {
      "type": "array",
      "maxItems": 10,
      "items": {"type": "string", "maxLength": 200}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"recommended_action": {"const": "REFUND"}},
        "required": ["recommended_action"]
      },
      "then": {
        "properties": {
          "evidence_refs": {"minItems": 1},
          "policy_refs": {"minItems": 1},
          "missing_evidence": {"maxItems": 0}
        }
      }
    }
  ]
}