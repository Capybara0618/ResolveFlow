    },
    "refund-result-in-an-impossible-state": {
      "schema": "urn:resolveflow:execution-result-event:v1#/$defs/refundResult",
      "why": "Result events report SUCCEEDED/FAILED/UNKNOWN only (docs/contracts.md:121). A terminal or intermediate operation state in a result payload means the producer and consumer disagree about the state machine.",
      "instance": {
