# Copy to infra/.env to override. Every value below is a DEVELOPMENT default;
# real environments inject these from the environment and never from this file.
# infra/.env must not be committed (docs/engineering.md 4).

# --- MySQL (holds commerce_db, fulfillment_db, case_db) ----------------------
MYSQL_ROOT_PASSWORD=root
# 3306 is free on this machine.
MYSQL_PORT=3306

# --- PostgreSQL + pgvector (holds agent_db) ----------------------------------
PG_USER=agent
PG_PASSWORD=agent
PG_DB=agent_db
# NOT 5432: another project on this machine already publishes Postgres on 5432.
# Claiming it would break that stack, so this project uses a distinct host port.
PG_PORT=55432

# --- Redis (cache, rate limiting, short-lived coordination) ------------------
# NOT 6379, for the same reason as Postgres above.
REDIS_PORT=56379

# --- RocketMQ -----------------------------------------------------------------
ROCKETMQ_NAMESRV_PORT=9876
ROCKETMQ_BROKER_PORT=10911
ROCKETMQ_BROKER_HA_PORT=10909
# The address the broker advertises to clients.
#   127.0.0.1       services and tests running on the host (default)
#   rocketmq-broker services running inside the compose network (app profile)
BROKER_IP1=127.0.0.1

# --- Nacos --------------------------------------------------------------------
NACOS_PORT=8848
NACOS_GRPC_PORT=9848
# Nacos 3.x refuses to start without this even when auth is disabled. The default
# in compose.yaml is a development-only token; override it anywhere real.
# NACOS_AUTH_TOKEN=
NACOS_AUTH_IDENTITY_KEY=resolveflow
NACOS_AUTH_IDENTITY_VALUE=resolveflow-dev-only