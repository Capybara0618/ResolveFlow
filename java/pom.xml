<?xml version="1.0" encoding="UTF-8"?>
<!--
  ResolveFlow Java reactor.

  Version pins and guards are carried over from T00, where each one was verified
  against a real build; see docs/compatibility-report.md and infra/versions.lock.yaml.
  Do not "helpfully" bump these without re-running the compatibility spike.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.0.8</version>
    <relativePath/>
  </parent>

  <groupId>com.resolveflow</groupId>
  <artifactId>resolveflow-java</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>resolveflow-java</name>
  <description>ResolveFlow Java services: gateway, commerce, fulfillment, case</description>

  <!--
    Building one service on its own requires -am (also-make), because every service
    depends on shared-kernel, which is a reactor SNAPSHOT:

      mvnw -f java/pom.xml -pl case-service -am test     # works from a clean repo
      mvnw -f java/pom.xml -pl case-service    test      # fails unless shared-kernel
                                                         # was installed first

    Verified both ways on a clean local repository. The failure is explicit
    ("Could not find artifact com.resolveflow:shared-kernel"), not silent.
  -->
  <modules>
    <module>shared-kernel</module>
    <module>gateway</module>
    <module>commerce-service</module>
    <module>fulfillment-service</module>
    <module>case-service</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Verified in T00. See infra/versions.lock.yaml. -->
    <spring-cloud.version>2025.1.3</spring-cloud.version>
    <spring-cloud-alibaba.version>2025.1.0.0</spring-cloud-alibaba.version>
    <mybatis-spring-boot.version>4.1.0</mybatis-spring-boot.version>
    <testcontainers.version>2.0.5</testcontainers.version>

    <spotless.version>3.10.2</spotless.version>
    <palantir-java-format.version>2.98.0</palantir-java-format.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.alibaba.cloud</groupId>
        <artifactId>spring-cloud-alibaba-dependencies</artifactId>
        <version>${spring-cloud-alibaba.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Declared after the SCA import on purpose: the SCA BOM also manages
           mybatis-spring-boot-starter at an older, Boot-3-only version, and the
           enforcer rule below fails the build if that ever wins. -->
      <dependency>
        <groupId>org.mybatis.spring.boot</groupId>
        <artifactId>mybatis-spring-boot-starter</artifactId>
        <version>${mybatis-spring-boot.version}</version>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <dependency>
        <groupId>com.resolveflow</groupId>
        <artifactId>shared-kernel</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <configuration>
            <excludes>
              <exclude>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
              </exclude>
            </excludes>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <argLine>-Dfile.encoding=UTF-8</argLine>
            <!-- Unit tests only; *IT is bound to failsafe under -Pintegration. -->
            <includes>
              <include>**/*Test.java</include>
            </includes>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <configuration>
            <argLine>-Dfile.encoding=UTF-8</argLine>
            <includes>
              <include>**/*IT.java</include>
            </includes>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- G0: "no SNAPSHOT, no disabled compatibility checks" as machine-checkable rules. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-versions</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,)</version>
                  <message>
                    ResolveFlow requires Java 21. Set JAVA_HOME to the JDK 21 install;
                    the host default may be older (see docs/compatibility-report.md).
                  </message>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                </requireMavenVersion>
                <requireReleaseDeps>
                  <message>
                    No SNAPSHOT third-party dependencies are allowed (G0). Depending on an
                    unreleased external artifact makes the build unreproducible. Intra-reactor
                    SNAPSHOTs (com.resolveflow) are excluded because they are built together.
                  </message>
                  <onlyWhenRelease>false</onlyWhenRelease>
                  <excludes>
                    <exclude>com.resolveflow:*</exclude>
                  </excludes>
                </requireReleaseDeps>
                <bannedDependencies>
                  <message>
                    MyBatis must stay on the Boot 4 compatible 4.x line; the SCA BOM
                    manages an older 3.0.x. If this fires, a freeze took effect.
                  </message>
                  <excludes>
                    <exclude>org.mybatis.spring.boot:mybatis-spring-boot-starter:[,4.0)</exclude>
                    <exclude>org.mybatis:mybatis-spring:[,4.0)</exclude>
                  </excludes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <palantirJavaFormat>
              <version>${palantir-java-format.version}</version>
            </palantirJavaFormat>
            <removeUnusedImports/>
            <trimTrailingWhitespace/>
            <endWithNewline/>
          </java>
        </configuration>
        <executions>
          <execution>
            <id>spotless-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!-- mvn -B verify -Pintegration -->
      <id>integration</id>
      <build>
        <plugins>
          <!--
            Declared WITHOUT an execution on purpose. spring-boot-starter-parent
            already binds a failsafe execution (integration-test + verify); adding
            a second one here made failsafe run twice per module, which would
            double-run every integration test once the DB/MQ suites land.
            Merely activating the plugin in this profile is enough; its
            configuration (includes **/*IT.java) comes from pluginManagement.
          -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>