  "documents": [
    {
      "id": "R-UNSHIPPED-001",
      "title": "已付款未发货",
      "text": "已成功付款且当前持久履约记录明确为 NOT_SHIPPED、版本为 1 并含 ORDER_PAID 事件时，可申请该订单行全部数量的实付金额退款；缺失物流、UNKNOWN 或已经发货不能按本规则退款。建议提交与人工批准时均须复核当前事实，最终由售后专员决定。",
      "kind": "EXISTING_SYNTHETIC_POLICY",
      "source_path": "fixtures/demo-foundation/policies/policy-foundation-m1001-2026.10.yaml",
      "source_sha256": "90142365a6a6ec43dff1052e10d080d514e5e953aadaee8a94f4a107b732d433",
      "source_section": "R-UNSHIPPED-001",
      "related_ids": [
        "R-MONEY-001"
      ],
      "content_sha256": "f0abcaa4b71c110ad56bef4fff9b32a29d50fe831b824459345e56596d24d0ec"
    },
    {
      "id": "R-LOST-001",
      "title": "承运商判定丢失",
      "text": "承运商结论为 LOST 且无有效签收记录时，经人工核验可按该订单行全部数量的实付金额退款；本地模拟在途不代表承运商丢失。",
      "kind": "EXISTING_SYNTHETIC_POLICY",
      "source_path": "fixtures/demo-foundation/policies/policy-foundation-m1001-2026.10.yaml",
      "source_sha256": "90142365a6a6ec43dff1052e10d080d514e5e953aadaee8a94f4a107b732d433",
      "source_section": "R-LOST-001",
      "related_ids": [
        "R-MONEY-001"
      ],
      "content_sha256": "a5afe1a5fd34322a727b6454ce949ff8b202e262fb2b708f8914eacfb705606b"
    },
    {
      "id": "R-SIGNED-001",
      "title": "已签收争议",
      "text": "存在有效签收记录时不能仅因客户主张未收到而退款，须人工核验签收争议；事实不足时要求补充材料或转人工调查。",
      "kind": "EXISTING_SYNTHETIC_POLICY",
      "source_path": "fixtures/demo-foundation/policies/policy-foundation-m1001-2026.10.yaml",
      "source_sha256": "90142365a6a6ec43dff1052e10d080d514e5e953aadaee8a94f4a107b732d433",
      "source_section": "R-SIGNED-001",
      "related_ids": [
        "R-MONEY-001"
      ],
      "content_sha256": "15f000581d3dcef1ef0a0bd5f3fe2d87fb0769689b4945ef960570af7928c010"
    },
    {
      "id": "R-DMG-001",
      "title": "商品损坏或质量问题",
      "text": "发货后的损坏或质量退款必须由人工核验客户材料与订单事实，确认符合售后条件后才可申请该订单行全部数量的实付金额退款；普通在途或未经核验的主张不足以批准。",
      "kind": "EXISTING_SYNTHETIC_POLICY",
      "source_path": "fixtures/demo-foundation/policies/policy-foundation-m1001-2026.10.yaml",
      "source_sha256": "90142365a6a6ec43dff1052e10d080d514e5e953aadaee8a94f4a107b732d433",
      "source_section": "R-DMG-001",
      "related_ids": [
        "R-MONEY-001"
      ],
      "content_sha256": "abe4c7dc89c2748aace666ee2ac3936ab9d1f537fdc2e0d4dfd87965b7d2b477"
    },
    {
      "id": "R-INTRANSIT-001",
      "title": "普通在途",
      "text": "IN_TRANSIT 本身不构成物流丢失或退款资格；尚无承运商异常结论且无其他经核验的退款理由时，要求补充信息或转人工，不按未发货规则退款。",
      "kind": "EXISTING_SYNTHETIC_POLICY",
      "source_path": "fixtures/demo-foundation/policies/policy-foundation-m1001-2026.10.yaml",
      "source_sha256": "90142365a6a6ec43dff1052e10d080d514e5e953aadaee8a94f4a107b732d433",
      "source_section": "R-INTRANSIT-001",
      "related_ids": [
        "R-MONEY-001"
      ],
      "content_sha256": "126f3198c005ef8b5af846a968cd1b3897553d21698f40ce40ad1db3a53b897f"
    },
    {
      "id": "R-MONEY-001",
      "title": "单行全额与人工决定",
      "text": "仅支持单订单行全部数量的全额模拟退款，同行最多一次成功，整单已退加预留不超过支付额，UNKNOWN 保留原操作和占用；不支持部分退款、补发或真实支付。模型建议与 confidence 均不是授权，不得自动审批。",
      "kind": "EXISTING_SYNTHETIC_POLICY",
      "source_path": "fixtures/demo-foundation/policies/policy-foundation-m1001-2026.10.yaml",
      "source_sha256": "90142365a6a6ec43dff1052e10d080d514e5e953aadaee8a94f4a107b732d433",
      "source_section": "R-MONEY-001",
      "related_ids": [],
      "content_sha256": "2d3063b1422c9987b0aec363ef084456ebc9730c8d4a515900599584fa517f1a"
    },
    {
      "id": "K-ORDER",
      "title": "选择订单商品与独立咨询",
      "text": "打开售后咨询后选择本人已付款订单中的商品。每个订单行独立保存咨询消息，更换商品会切换到对应商品的会话，原咨询记录保留。",
      "kind": "CODEX_SOURCE_BOUND_PROCESS_SUMMARY",
      "source_path": "docs/customer-support-workspace.md",
      "source_sha256": "590a885a5a87bd9a042e25cca3cebc3849d980c768e10ddfc867cbcb04f9a046",
      "source_section": "买家",
      "related_ids": [],
      "content_sha256": "0b9024410e73cb06276d40e13032e841b129006e139c08360062d681bbdaec30"
    },
    {
      "id": "K-HANDOFF",
      "title": "不申请退款也能请商家核查",
      "text": "需要人工帮助时，可点击请商家核查，预览并编辑转交摘要后确认提交。不需要填写退款金额，也不会因此提交退款申请。",
      "kind": "CODEX_SOURCE_BOUND_PROCESS_SUMMARY",
      "source_path": "docs/customer-support-workspace.md",
      "source_sha256": "590a885a5a87bd9a042e25cca3cebc3849d980c768e10ddfc867cbcb04f9a046",
      "source_section": "买家",
      "related_ids": [],
      "content_sha256": "879a4c3ad27ab5621f84ed2eb5cc43cf0e18351ff46081ecb2dbb265961166f0"
    },
    {
      "id": "K-SHARE",
      "title": "转交前选择共享原文和调查依据",
      "text": "转交商家前，客户选择共享哪些客户原文，以及本回答的订单、物流或政策依据。调查依据默认不勾选；对话历史不会随依据自动共享。只有客户确认的内容才发给商家。",
      "kind": "CODEX_SOURCE_BOUND_PROCESS_SUMMARY",
      "source_path": "docs/customer-support-workspace.md",
      "source_sha256": "590a885a5a87bd9a042e25cca3cebc3849d980c768e10ddfc867cbcb04f9a046",
      "source_section": "买家",
      "related_ids": [],
      "content_sha256": "eea932ba2356c4434fe1d2a89afd819bd70de0d853c0a3520fa48cb663a3fb07"
    },
    {
      "id": "K-PRIVATE",
      "title": "私有助手咨询与补充给商家的区别",
      "text": "转交后默认输入补充给商家，消息进入原核查单。可切换询问智能助手，这类咨询和助手回答不自动交给商家。商家只能读取客户确认共享及后续发给商家的消息。",
      "kind": "CODEX_SOURCE_BOUND_PROCESS_SUMMARY",
      "source_path": "docs/customer-support-workspace.md",
      "source_sha256": "590a885a5a87bd9a042e25cca3cebc3849d980c768e10ddfc867cbcb04f9a046",
      "source_section": "买家/商家",
      "related_ids": [],
      "content_sha256": "f5aed43a041386b8781354bc6237a1acc0a5ce41b5aa370134f0cb9f6df082b1"
    },
    {
      "id": "K-RESOLVE",
      "title": "商家回复与客户确认解决",
      "text": "商家可以核查回复或请求客户补充。已回复不会自动变成已解决，客户可继续补充或确认解决。解决后客户再次补充会接续原核查单，咨询不限制为两轮补充。",
      "kind": "CODEX_SOURCE_BOUND_PROCESS_SUMMARY",
      "source_path": "docs/customer-support-workspace.md",
      "source_sha256": "590a885a5a87bd9a042e25cca3cebc3849d980c768e10ddfc867cbcb04f9a046",
      "source_section": "买家/商家",
      "related_ids": [],
      "content_sha256": "2b4c156fca14434c77590441fd3fd4ccc98d8e01ee000de7f4bb7754cf9f9fac"
    },
    {
      "id": "K-STATUS",
      "title": "查看核查进度和历史消息",
      "text": "咨询记录会自动检查进度，也可手动刷新。读取更早消息时暂停自动刷新，避免打断阅读。商家在本店咨询核查工作台查看已确认的共享材料并回复。",
      "kind": "CODEX_SOURCE_BOUND_PROCESS_SUMMARY",
      "source_path": "docs/customer-support-workspace.md",
      "source_sha256": "590a885a5a87bd9a042e25cca3cebc3849d980c768e10ddfc867cbcb04f9a046",
      "source_section": "买家/商家",
      "related_ids": [],
      "content_sha256": "f655a65dee43308fbf3d69bb4cd2bb08b420ff2821569803b9e0b3df9b1f1b87"
    },
    {
      "id": "K-RETRY",
      "title": "发送结果不明确与版本冲突",
      "text": "网络结果尚未确认时，使用原请求确认结果，刷新同一浏览器标签页后保留原请求标识。版本冲突时保留输入并提示刷新，不自动提交过时的转交摘要。",
      "kind": "CODEX_SOURCE_BOUND_PROCESS_SUMMARY",
      "source_path": "docs/customer-support-workspace.md",
      "source_sha256": "590a885a5a87bd9a042e25cca3cebc3849d980c768e10ddfc867cbcb04f9a046",
      "source_section": "买家",
      "related_ids": [],
      "content_sha256": "ad62323703821ebce40ab2156956f23d914c571a1f5f1630d1d122e1be9a20be"
    },
    {
      "id": "K-ENTRY",
      "title": "正式退款申请与咨询入口",
      "text": "当前可用的正式退款申请入口为我的售后。售后咨询内的退款摘要确认和Case关联尚未接通，聊天表示想退款或提交人工核查并不会自动创建退款工单。",
      "kind": "CODEX_SOURCE_BOUND_PROCESS_SUMMARY",
      "source_path": "docs/customer-support-workspace.md",
      "source_sha256": "590a885a5a87bd9a042e25cca3cebc3849d980c768e10ddfc867cbcb04f9a046",
      "source_section": "买家",
      "related_ids": [],
      "content_sha256": "2fe4ceca600510fd2656f2ca4ee760f3ecb913fc41afbe5e32b172308ff76a68"
    },
    {
      "id": "K-SOURCES",
      "title": "助手回答来源与实时事实",
      "text": "助手按问题选择读取订单、物流、历史或绑定版本的本店政策。回答来源可展开查看版本和原文；订单当前物流状态、退款执行结果须从业务接口读取，知识文档不能证明某笔订单已发货、已丢失或已退款。",
      "kind": "CODEX_SOURCE_BOUND_PROCESS_SUMMARY",
      "source_path": "docs/customer-agent-implementation-v1.md",
      "source_sha256": "3826ffaadd7ea6f55be72a305e1c72c36be8dba7718f9383b6cb9d72633cfdba",
      "source_section": "上下文与检索",
      "related_ids": [],
      "content_sha256": "612667d73a8062856b9d7b8b5ee0a170ddbbfadf53cd27e1968f5da779623d93"
    },
    {
      "id": "K-STALE",
      "title": "补充纠正与过时回答",
      "text": "客户生成期间可以继续补充、纠正情况或更换商品。旧输入对应的回复不会发布成最新回答；失败后可以重新提问或请商家核查。",
      "kind": "CODEX_SOURCE_BOUND_PROCESS_SUMMARY",
