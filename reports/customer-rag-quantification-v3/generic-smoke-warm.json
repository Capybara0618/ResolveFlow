            "block_id": "jd-digital:b0007",
            "text_range": [
              0,
              9
            ],
            "text": "1.商品质量问题。"
          },
          {
            "source_id": "jd-digital",
            "raw_sha256": "41a42945549a2cfb677b3c4d38bfaa90e1d5053c57c7d8941141eec84f305968",
            "block_id": "jd-digital:b0008",
            "text_range": [
              0,
              26
            ],
            "text": "2.7日内在商品（含附件）完好前提下申请无理由退货。"
