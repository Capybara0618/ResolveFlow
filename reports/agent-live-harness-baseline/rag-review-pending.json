  "instructions": "逐query判断项目条款相关性；must_rules=null为待标注，[]仅用于确认无适用条款。先看问法及完整条款再看候选，不能抄最终工单Gold，不写京东政策或授权。",
  "policy_bundles": [
    {
      "bundle_id": "eval-m-1001-v1",
      "merchant_id": "M-1001",
      "version": "v1",
      "effective_from": "2026-09-01",
      "effective_to": "2026-10-01",
      "synthetic": true,
      "rules": [
        {
          "rule_id": "R-UNSHIPPED-001",
          "title": "付款后尚未发货",
          "text": "商品已付款，商家履约记录明确尚未发货，且没有退款占用时，可以申请该商品行全部数量的实付全额退款。买错规格、重复购买或改变购买计划均可提出申请。不能用没有物流记录代替尚未发货的确认；已经发货时应调查其他理由。"
        },
        {
          "rule_id": "R-LOST-001",
          "title": "运输丢失",
          "text": "承运记录确认包裹丢失、没有有效签收记录，且商家已核验丢失事实时，可以建议该商品行实付全额退款。只有运输延迟、普通在途或客户单方声称没有收到，不足以确认丢失。签收和丢失记录冲突时先核验。"
        },
        {
          "rule_id": "R-SIGNED-001",
          "title": "签收争议",
          "text": "物流显示有效签收但客户说没收到，应核对签收人与客户说明，缺少关键说明时补证或转人工。不能仅凭签收状态确认客户实际收货，也不能仅凭未收到的主张建议退款。若人工核验确认错误签收且承运记录已确认丢失，按运输丢失条款继续判断。"
        },
        {
          "rule_id": "R-DMG-001",
          "title": "商品质量或破损",
          "text": "商品发货后存在损坏或功能质量问题，人工核验确认问题属实并符合售后条件时，可以建议该商品行实付全额退款。未经核验的客户陈述或一张已上传的图片不能自动证明问题；核验结果未知或材料相互矛盾时补证或转人工。核验否认某项事实仅否认该理由，不能代替对其他有效理由的调查。"
        },
        {
          "rule_id": "R-INTRANSIT-001",
          "title": "运输中与延迟",
          "text": "普通运输中或配送变慢不等于丢失。应查看承运异常及客户理由，不能套用尚未发货退款条款。没有异常结论或存在其他未核验理由时，提出具体补充问题或交由商家人工处理。"
        },
        {
          "rule_id": "R-UNKNOWN-001",
          "title": "履约信息不足",
          "text": "付款或发货状态无法确认、记录缺失或读取失败时，不得假定已付款未发货，也不得据此认定客户无权申请。应说明缺少哪项事实，重新取得有效记录或转人工；不得编造物流、付款和核验结论。"
        },
        {
          "rule_id": "R-MONEY-001",
          "title": "退款记录与处理范围",
          "text": "已有退款成功记录时不得再次建议执行同一商品行退款；退款处理中或结果尚不明确时先核对原处理记录。本系统只处理单商品行全部数量的实付全额模拟退款，不支持行内部分退款、补发、真实支付或退货入库。模型仅提供建议，最终由商家审批；任何建议不产生退款授权。"
        },
        {
          "rule_id": "R-QUESTION-001",
          "title": "补充说明与已有回答",
          "text": "补证只询问影响判断且尚未回答的问题，并说明需要补充的内容。已经回答的同一问题不得重复询问。现有信息仍不足或有冲突时交由商家处理；材料为空不是直接拒绝申请的理由。"
        },
        {
          "rule_id": "R-MATERIAL-001",
          "title": "数码商品核验材料",
          "text": "商品质量争议需要补充问题说明，由商家人工核验。"
        }
      ]
    },
